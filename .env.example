# Copy to .env before the first start:  cp .env.example .env
# Local development values only. Never commit the real .env.

# Data warehouse (PostgreSQL)
DENG_DB_NAME=deng
DENG_DB_USER=deng
DENG_DB_PASSWORD=change-me-deng

# Airflow metadata database (same Postgres instance, separate database)
AIRFLOW_DB_PASSWORD=change-me-airflow

# Airflow web UI login
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Host ports (change if 5432 / 8080 are already in use on your machine)
POSTGRES_HOST_PORT=5432
AIRFLOW_HOST_PORT=8080
